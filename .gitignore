# chezmoi files tracked despite .* rule below
!.chezmoi.toml.tmpl
!.chezmoiignore
!.chezmoiroot
!home/.chezmoiscripts
!home/.chezmoiscripts/**
!home/.chezmoidata
!home/.chezmoidata/**
!home/.chezmoitemplates
!home/.chezmoitemplates/**

# ignore everything else starting with dot
.*

# local secrets and overrides — never commit
*.local
