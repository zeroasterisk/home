# chezmoi files tracked despite .* rule below
!.chezmoi.toml.tmpl
!.chezmoiignore
!.chezmoiroot
!home/.chezmoiscripts
!home/.chezmoiscripts/**
!home/.chezmoidata
!home/.chezmoidata/**
!home/.chezmoitemplates
!home/.chezmoitemplates/**

# ignore everything else starting with dot
.*

# local secrets and overrides — never commit
# (note: dot_tmux.conf.local IS tracked — it's not a secret)
*.local
!home/dot_tmux.conf.local

# runtime-generated / on-disk remnants from old tree — not source
bin/
tool-versions
vim/
zsh/
