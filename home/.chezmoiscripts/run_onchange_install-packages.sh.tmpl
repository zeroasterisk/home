#!/usr/bin/env bash
# run_onchange_install-packages.sh — managed by chezmoi
# Runs whenever this file changes (e.g. you add a package to a list).
# Idempotent: checks before installing, continues past failures.

set -uo pipefail

log()  { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m  ✓ %s\033[0m\n' "$*"; }
skip() { printf '\033[1;33m  - %s\033[0m\n' "$*"; }
warn() { printf '\033[1;31m  ! %s\033[0m\n' "$*"; }

# ── System packages ───────────────────────────────────────────────────────────

{{ if eq .chezmoi.os "linux" -}}
log "Installing system packages (apt)..."

APT_CORE=(
  zsh
  tmux
  git
  curl
  wget
  jq
  ripgrep       # rg
  fd-find       # fd (note: binary is 'fdfind' on Debian, symlink to fd)
  fzf
  htop
  tree
  unzip
  build-essential
  libssl-dev
  # zsh plugins
  zsh-autosuggestions
  zsh-syntax-highlighting
)

{{ if .work -}}
APT_WORK=(
  # jj is not in apt; installed separately if needed
  mtr-tiny
  nmap
)
{{- end }}

# ── Optional extras — uncomment to include ────────────────────────────────────
# APT_EXTRAS=(
#   tig           # git TUI
#   silversearcher-ag  # ag (largely replaced by rg)
#   ncdu          # disk usage TUI
#   bat           # better cat (binary: batcat on Debian)
#   gh            # GitHub CLI (needs external repo on older Debian)
#   podman        # container runtime
#   neovim        # if not using asdf-managed neovim
# )

PACKAGES=("${APT_CORE[@]}")
{{ if .work -}}
PACKAGES+=("${APT_WORK[@]}")
{{- end }}

for pkg in "${PACKAGES[@]}"; do
  # skip comment lines
  [[ "${pkg}" == \#* ]] && continue
  if dpkg -l "${pkg}" &>/dev/null 2>&1; then
    skip "${pkg} already installed"
  else
    sudo apt-get install -y "${pkg}" 2>/dev/null && ok "${pkg}" || warn "${pkg} failed — skipping"
  fi
done

# fd symlink: Debian installs as fdfind
if command -v fdfind &>/dev/null && ! command -v fd &>/dev/null; then
  mkdir -p "${HOME}/.local/bin"
  ln -sf "$(command -v fdfind)" "${HOME}/.local/bin/fd"
  ok "fd symlinked from fdfind"
fi

{{ else if eq .chezmoi.os "darwin" -}}
log "Installing system packages (brew)..."

if ! command -v brew &>/dev/null; then
  warn "Homebrew not found — install it first: https://brew.sh"
  exit 0
fi

BREW_CORE=(
  zsh
  tmux
  git
  curl
  wget
  jq
  ripgrep
  fd
  fzf
  htop
  tree
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-history-substring-search
)

{{ if .work -}}
BREW_WORK=(
  mtr
  nmap
)
{{- end }}

# ── Optional extras — uncomment to include ────────────────────────────────────
# BREW_EXTRAS=(
#   tig
#   bat
#   gh
#   ncdu
#   podman
#   neovim        # if not using asdf-managed neovim
#   font-fira-code-nerd-font   # nerd fonts (cask)
#   font-hack-nerd-font
# )

FORMULAE=("${BREW_CORE[@]}")
{{ if .work -}}
FORMULAE+=("${BREW_WORK[@]}")
{{- end }}

for formula in "${FORMULAE[@]}"; do
  [[ "${formula}" == \#* ]] && continue
  if brew list "${formula}" &>/dev/null 2>&1; then
    skip "${formula} already installed"
  else
    brew install "${formula}" && ok "${formula}" || warn "${formula} failed — skipping"
  fi
done

{{- end }}

# ── asdf ─────────────────────────────────────────────────────────────────────
log "Setting up asdf..."

ASDF_DIR="${HOME}/.asdf"

if [[ ! -d "${ASDF_DIR}" ]]; then
  git clone https://github.com/asdf-vm/asdf.git "${ASDF_DIR}" --branch v0.16.7
  ok "asdf cloned"
else
  skip "asdf already present"
fi

# Source asdf so we can use it immediately
# shellcheck disable=SC1091
[[ -f "${ASDF_DIR}/asdf.sh" ]] && source "${ASDF_DIR}/asdf.sh"

if ! command -v asdf &>/dev/null; then
  warn "asdf not on PATH after sourcing — skipping plugin installs"
  exit 0
fi

# ── asdf plugin + runtime installer ──────────────────────────────────────────
install_asdf_plugin() {
  local name="$1"
  local url="${2:-}"
  if asdf plugin list | grep -q "^${name}$"; then
    skip "asdf plugin ${name} already added"
  else
    if [[ -n "${url}" ]]; then
      asdf plugin add "${name}" "${url}" && ok "asdf plugin add ${name}" || warn "asdf plugin add ${name} failed"
    else
      asdf plugin add "${name}" && ok "asdf plugin add ${name}" || warn "asdf plugin add ${name} failed"
    fi
  fi
}

install_asdf_version() {
  local name="$1"
  local version="$2"
  if asdf list "${name}" 2>/dev/null | grep -q "${version}"; then
    skip "asdf ${name} ${version} already installed"
  else
    asdf install "${name}" "${version}" && ok "asdf ${name} ${version}" || warn "asdf ${name} ${version} failed"
  fi
  asdf set --home "${name}" "${version}" 2>/dev/null || true
}

# ── Core runtimes — always installed ─────────────────────────────────────────
log "Installing core asdf runtimes..."

install_asdf_plugin "nodejs"
install_asdf_version "nodejs" "25.9.0"

install_asdf_plugin "python"
install_asdf_version "python" "3.12.10"

install_asdf_plugin "golang" "https://github.com/asdf-community/asdf-golang.git"
install_asdf_version "golang" "1.25.0"

install_asdf_plugin "neovim"
install_asdf_version "neovim" "0.11.1"

