#!/usr/bin/env bash
# run_onchange_install-packages.sh — managed by chezmoi
# Runs whenever this file changes (e.g. you add a package).
# Idempotent: skips already-installed packages, continues past failures.
#
# ── HOW TO EDIT THIS FILE ─────────────────────────────────────────────────────
#
# Adding a system package:
#   1. Add it to BOTH the apt (linux) and brew (darwin) lists below.
#   2. Note any name difference as a comment (e.g. fd-find vs fd, mtr-tiny vs mtr).
#   3. Run: chezmoi apply
#
# Adding an asdf runtime:
#   1. Uncomment (or add) the _plugin + _runtime pair in the extras section.
#   2. Run: chezmoi apply
#   3. If it needs system deps (e.g. erlang needs libssl-dev), add those to
#      the apt/brew lists first.
#
# Upgrading a pinned version:
#   1. Change the version string in the _runtime call.
#   2. Run: chezmoi apply  — the new version installs alongside the old one.
#   3. The old version is left in place; remove manually with: asdf uninstall <name> <old>
#
# Promoting an extra to core:
#   1. Uncomment the _plugin/_runtime lines and move them up to the core block.
#
# On a new machine:
#   chezmoi init --source ~/dotfiles && chezmoi apply
#   (or use install.sh which does the same thing)
#
# ─────────────────────────────────────────────────────────────────────────────

set -uo pipefail

log()  { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m  ✓ %s\033[0m\n' "$*"; }
skip() { printf '\033[1;33m  - %s\033[0m\n' "$*"; }
warn() { printf '\033[1;31m  ! %s\033[0m\n' "$*"; }

# ── Linux (apt) ───────────────────────────────────────────────────────────────
{{ if eq .chezmoi.os "linux" -}}
log "System packages (apt)..."

PACKAGES=(
  # core shell + tools
  zsh
  tmux
  git
  curl
  wget
  jq
  htop
  tree
  unzip
  build-essential   # mac: xcode-select --install
  libssl-dev        # mac: handled by brew openssl

  # search (mac: ripgrep, fd, fzf — same names)
  ripgrep
  fd-find           # mac: fd  |  binary is 'fdfind', symlinked below
  fzf

  # zsh plugins (mac: brew install; zsh-history-substring-search via curl)
  zsh-autosuggestions
  zsh-syntax-highlighting

  {{ if .work -}}
  # work extras
  mtr-tiny          # mac: mtr
  nmap
  {{- end }}

  # ── Extras — uncomment + chezmoi apply to install ──────────────────────────
  # tig             # git TUI          (same on brew)
  # bat             # better cat       (mac: bat | apt binary: batcat)
  # ncdu            # disk usage TUI   (same on brew)
  # gh              # GitHub CLI       (needs external repo on older Debian)
  # podman          # containers       (same on brew)
)

for pkg in "${PACKAGES[@]}"; do
  [[ "${pkg}" == \#* ]] && continue
  if dpkg -l "${pkg}" &>/dev/null 2>&1; then
    skip "${pkg}"
  else
    sudo apt-get install -y "${pkg}" 2>/dev/null && ok "${pkg}" || warn "${pkg} failed"
  fi
done

# Debian installs fd as 'fdfind' — symlink to 'fd'
if command -v fdfind &>/dev/null && ! command -v fd &>/dev/null; then
  mkdir -p "${HOME}/.local/bin"
  ln -sf "$(command -v fdfind)" "${HOME}/.local/bin/fd"
  ok "fd -> fdfind symlink created"
fi

# zsh-history-substring-search not in apt — install manually
HSS="${HOME}/.zsh/plugins/zsh-history-substring-search.zsh"
if [[ ! -f "${HSS}" ]]; then
  mkdir -p "${HOME}/.zsh/plugins"
  curl -fsSL https://raw.githubusercontent.com/zsh-users/zsh-history-substring-search/master/zsh-history-substring-search.zsh \
    -o "${HSS}" && ok "zsh-history-substring-search" || warn "zsh-history-substring-search failed"
else
  skip "zsh-history-substring-search"
fi

# ── macOS (brew) ──────────────────────────────────────────────────────────────
{{ else if eq .chezmoi.os "darwin" -}}
log "System packages (brew)..."

if ! command -v brew &>/dev/null; then
  warn "Homebrew not found — install: https://brew.sh"
  exit 0
fi

FORMULAE=(
  # core shell + tools
  zsh
  tmux
  git
  curl
  wget
  jq
  htop
  tree

  # search (linux: ripgrep, fd-find, fzf — same names except fd-find->fd)
  ripgrep
  fd
  fzf

  # zsh plugins (linux: apt + manual curl for hss)
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-history-substring-search

  {{ if .work -}}
  # work extras
  mtr               # linux: mtr-tiny
  nmap
  {{- end }}

  # ── Extras — uncomment + chezmoi apply to install ──────────────────────────
  # tig             # git TUI          (same on apt)
  # bat             # better cat       (linux apt binary: batcat)
  # ncdu            # disk usage TUI   (same on apt)
  # gh              # GitHub CLI       (same on apt)
  # podman          # containers       (same on apt)
  # font-fira-code-nerd-font  # cask
  # font-hack-nerd-font       # cask
)

for formula in "${FORMULAE[@]}"; do
  [[ "${formula}" == \#* ]] && continue
  if brew list "${formula}" &>/dev/null 2>&1; then
    skip "${formula}"
  else
    brew install "${formula}" && ok "${formula}" || warn "${formula} failed"
  fi
done

{{- end }}

# ── asdf ──────────────────────────────────────────────────────────────────────
log "asdf setup..."

ASDF_DIR="${HOME}/.asdf"
if [[ ! -d "${ASDF_DIR}" ]]; then
  git clone https://github.com/asdf-vm/asdf.git "${ASDF_DIR}" --branch v0.16.7
  ok "asdf cloned"
else
  skip "asdf"
fi

# shellcheck disable=SC1091
[[ -f "${ASDF_DIR}/asdf.sh" ]] && source "${ASDF_DIR}/asdf.sh"

if ! command -v asdf &>/dev/null; then
  warn "asdf not on PATH — skipping runtime installs"
  exit 0
fi

_plugin() {
  local name="$1" url="${2:-}"
  asdf plugin list 2>/dev/null | grep -q "^${name}$" && { skip "plugin ${name}"; return; }
  asdf plugin add "${name}" ${url:+"${url}"} && ok "plugin ${name}" || warn "plugin ${name} failed"
}

_runtime() {
  local name="$1" version="$2"
  asdf list "${name}" 2>/dev/null | grep -q "${version}" && { skip "${name} ${version}"; return; }
  asdf install "${name}" "${version}" && ok "${name} ${version}" || warn "${name} ${version} failed"
  asdf set --home "${name}" "${version}" 2>/dev/null || true
}

# ── Core runtimes — always installed ─────────────────────────────────────────
log "asdf core runtimes..."

_plugin "nodejs"
_runtime "nodejs" "25.9.0"

_plugin "python"
_runtime "python" "3.12.10"

_plugin "golang" "https://github.com/asdf-community/asdf-golang.git"
_runtime "golang" "1.25.0"

_plugin "neovim"
_runtime "neovim" "0.11.1"

