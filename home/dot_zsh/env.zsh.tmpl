# ~/.zsh/env.zsh — managed by chezmoi
# Committed environment defaults. Secrets go in ~/.zsh/local.zsh (gitignored).

export LANG="en_US.UTF-8"
export EDITOR="nvim"
export VISUAL="nvim"

# fzf — use ripgrep as source
export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git/*" --glob "!.meteor/*"'
export FZF_CTRL_T_COMMAND="${FZF_DEFAULT_COMMAND}"

# asdf data directory
export ASDF_DATA_DIR="${HOME}/.asdf"

# uv — always use public PyPI
export UV_DEFAULT_INDEX="https://pypi.org/simple"

# Elixir/Erlang — persistent iex history
export ERL_AFLAGS="-kernel shell_history enabled"

# ── Work / GCP defaults ───────────────────────────────────────────────────────
{{- if .work }}
export GOOGLE_CLOUD_PROJECT="{{ .gcp_project }}"
export CLOUDSDK_COMPUTE_REGION="{{ .gcp_region }}"
export GOOGLE_CLOUD_LOCATION="{{ .gcp_region }}"
{{- end }}

# ── macOS-specific ────────────────────────────────────────────────────────────
{{- if eq .chezmoi.os "darwin" }}
export JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null || echo '')"
export GRADLE_HOME="/opt/local/share/java/gradle"
export ANDROID_HOME="${HOME}/Library/Android/sdk"
{{- end }}

# G4 filter for gLinux Perforce
{{- if and .work (eq .chezmoi.os "linux") }}
_g4_patterns=(
  "__pycache__/" ".*\.py[cod]$" ".*\.so$" "\.Python/"
  "build/" "develop-eggs/" "dist/" "downloads/" "eggs/" "\.eggs/"
  "lib/" "lib64/" "parts/" "sdist/" "var/" "wheels/"
  "pip-wheel-metadata/" "share/python-wheels/"
  ".*\.egg-info/" "\.installed\.cfg$" ".*\.egg$" "MANIFEST"
  "\.venv/" "venv/" "env/" "site/"
  "\.idea/" "\.vscode/" "\.pytest_cache/" "\.coverage$"
  "htmlcov/" "\.tox/" "\.nox/" "\.cache/"
)
export G4NOTHAVEFILTER="$(IFS='|'; echo "${_g4_patterns[*]}")"
unset _g4_patterns
{{- end }}
