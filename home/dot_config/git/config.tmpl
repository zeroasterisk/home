# ~/.config/git/config — managed by chezmoi
# Personal defaults. Work identity applied via includeIf.

[user]
  name  = {{ .name }}
  email = {{ .email }}
  signingKey = ~/.ssh/id_ed25519

[github]
  user = {{ .github }}

# ── Identity switching via directory ──────────────────────────────────────────
[includeIf "gitdir:/google/"]
  path = ~/.config/git/work.gitconfig
[includeIf "gitdir:~/Workspaces/google-git/"]
  path = ~/.config/git/work.gitconfig

# ── Core ──────────────────────────────────────────────────────────────────────
[core]
  pager      = cat
  editor     = nvim
  autocrlf   = input
  symlinks   = true
  whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[init]
  defaultBranch = main
  templateDir   = ~/.config/git/git_template

[pull]
  rebase = true

[push]
  default = current

[branch]
  autosetupmerge = true

# ── Colors ────────────────────────────────────────────────────────────────────
[color]
  ui = auto

[color "branch"]
  current = yellow reverse
  local   = yellow
  remote  = green

[color "diff"]
  meta      = yellow bold
  frag      = magenta bold
  old       = red bold
  new       = green bold
  whitespace = red reverse

[color "status"]
  added     = yellow
  changed   = green
  untracked = cyan

# ── Signing (SSH) ─────────────────────────────────────────────────────────────
[gpg]
  format = ssh

[commit]
  gpgSign = true

[tag]
  gpgSign = true

[gpg "ssh"]
  allowedSignersFile = ~/.ssh/allowed_signers

# ── Useful aliases ────────────────────────────────────────────────────────────
[alias]
  st      = status
  co      = checkout
  br      = branch
  df      = diff
  lg      = log --oneline --decorate --graph
  ql      = log --pretty=format:'%Cblue%h %Cred%cD %Creset%cn %Cgreen%s%Creset' --date-order --graph
  up      = pull --rebase
  p       = push origin
  undo    = reset --soft HEAD^
  unstage = reset HEAD
  ignore  = update-index --assume-unchanged
  tags    = describe --abbrev=0 --tags
  worddiff = diff --word-diff
  subup   = submodule update --init --recursive

# ── LFS ───────────────────────────────────────────────────────────────────────
[filter "lfs"]
  required = true
  clean    = git-lfs clean -- %f
  smudge   = git-lfs smudge -- %f
  process  = git-lfs filter-process

# ── Merge ─────────────────────────────────────────────────────────────────────
[merge]
  conflictstyle = diff3

[mergetool]
  keepBackup = false

# ── Google SSO URL rewrites (work machines) ───────────────────────────────────
{{- if .work }}
[url "sso://applied-ai-engineering/"]
  insteadOf = https://applied-ai-engineering.googlesource.com/
  insteadOf = https://applied-ai-engineering-review.googlesource.com/
  insteadOf = http://applied-ai-engineering.googlesource.com/
  insteadOf = http://applied-ai-engineering-review.googlesource.com/

[url "git@depot.code.corp.goog:"]
  insteadOf = https://depot.code.corp.goog/
{{- end }}

# ── sendemail ─────────────────────────────────────────────────────────────────
[sendemail]
  smtpserver     = smtp.gmail.com
  smtpserverport = 587
  smtpencryption = tls
  smtpuser       = {{ .email }}
