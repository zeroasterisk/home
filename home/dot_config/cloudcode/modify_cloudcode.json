#!/usr/bin/env python3
# chezmoi modify_ script: writes the shared CloudCode config and keeps this
# machine's skills.paths and plugin list, which point at what is installed here
# (skills/sync.sh generates skills.paths).
import json
import sys

BASE = json.loads(r"""
{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex/gemini-4-neon",
  "agent": {
    "plan": {
      "model": "google-vertex/gemini-4-neon"
    },
    "build": {
      "model": "google-vertex/gemini-4-neon"
    },
    "worker": {
      "model": "google-vertex/gemini-3.8-flash",
      "mode": "primary",
      "description": "General worker agent using gemini-3.8-flash"
    },
    "deep-thinker": {
      "model": "google-vertex-anthropic/claude-fable-5-1@default",
      "mode": "primary",
      "description": "Deep thinking agent using Claude Fable 5.1"
    },
    "opus": {
      "model": "google-vertex-anthropic/claude-opus-5-5@default",
      "mode": "primary",
      "description": "Premium reasoning agent using Claude Opus 5.5"
    }
  },
  "formatter": false,
  "permission": {
    "*": "allow"
  },
  "lsp": false,
  "tools": {
    "question": false
  },
  "memory": {
    "enabled": true
  },
  "provider": {
    "google-vertex": {
      "options": {
        "project": "alanblount-demo",
        "location": "global"
      }
    },
    "google-vertex-anthropic": {
      "options": {
        "project": "alanblount-demo",
        "location": "global"
      }
    }
  },
  "skills": {
    "bundles": [
      "google-corp",
      "google3"
    ]
  }
}
""")

try:
    current = json.loads(sys.stdin.read() or "{}")
except json.JSONDecodeError:
    current = {}

paths = current.get("skills", {}).get("paths")
if paths:
    BASE.setdefault("skills", {})["paths"] = paths
if current.get("plugin"):
    BASE["plugin"] = current["plugin"]

print(json.dumps(BASE, indent=2))
