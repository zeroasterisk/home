# Customize env all the time

# Fix for uv to force it to use pypi.org/simple as the default index
export UV_DEFAULT_INDEX=https://pypi.org/simple

# Preferred editor — used by cloudcode /editor, git commit messages, etc.
export EDITOR=nvim
export VISUAL=nvim

# Google Cloud defaults
export GOOGLE_CLOUD_PROJECT="alanblount-sandbox"
export CLOUDSDK_COMPUTE_REGION="us-east5"
export GOOGLE_CLOUD_LOCATION="us-east5"

# Sketchy but convenient
# export GEMINI_API_KEY="..."
# export GOOGLE_API_KEY="..."
